# 本地单机演示；该用户和演示素材都清楚标注为虚构，勿用于公网生产。
APP_ENV=development
DEMO_MODE=true
DATABASE_URL=sqlite:///./data/runtime/daily_ai_news.db
REDIS_URL=redis://localhost:6379/0
CELERY_ENABLED=false
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# 管理反馈的账户邮箱，多个地址用逗号分隔；留空时所有账户均无管理员权限。
ADMIN_EMAILS=
BASE_URL=http://localhost:8080
APP_BIND_ADDRESS=127.0.0.1
WEB_BIND_ADDRESS=127.0.0.1

# Cloudflare Tunnel (leave empty until a tunnel is created in Cloudflare).
# Store the token only in the local, Git-ignored .env file; never paste it into chat.
CLOUDFLARE_TUNNEL_TOKEN=

# 首选模型基线：Qwen3.8-Flash。按 API Key 类型和地域填写对应兼容地址。
# 普通业务空间与 Token Plan 的 Base URL 不同；只在服务端配置密钥。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=qwen3.8-flash
# Qwen3.8-Flash 默认保留深度思考以维护摘要事实与时间限定；仅在实测后考虑关闭。
LLM_ENABLE_THINKING=true
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TURNS=12
LLM_MAX_TOOL_CALLS=20
LLM_MAX_TASK_TOKENS=30000
LLM_MAX_COMPLETION_TOKENS=8192
# 可选：仅当运行环境必须经过 HTTP(S) 代理访问模型服务时设置；密钥仍只放在本机 .env。
# 容器访问 Windows 主机代理的示例：HTTPS_PROXY=http://host.docker.internal:7897
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,api,db,redis,web
LOGIN_CODE_EMAIL_HOUR_LIMIT=5
LOGIN_CODE_IP_HOUR_LIMIT=30
DAILY_DISPATCH_BATCH_SIZE=10000
# SQLAlchemy connection budget is per process; API_WORKERS multiplies DB_POOL_SIZE + DB_MAX_OVERFLOW.
API_WORKERS=4
CELERY_WORKER_CONCURRENCY=4
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=5
# 浏览器通知目前未启用；不配置原生推送令牌或供应商密钥。

# 建议使用正式邮件服务完成验证码发送；未配置邮件服务时禁止公开注册。
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=false

# 可选：仅在来源具有明确可用及合法访问条件时启用 Feed 抓取。
RSS_REFRESH_MINUTES=30
FEED_REQUEST_TIMEOUT_SECONDS=15
