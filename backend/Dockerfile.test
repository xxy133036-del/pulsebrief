FROM ghcr.io/astral-sh/uv:0.13.5 AS uv

FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PYTHONPATH=/srv/backend \
    UV_PROJECT_ENVIRONMENT=/opt/venv
ENV PATH="/opt/venv/bin:${PATH}"

WORKDIR /srv/backend
COPY --from=uv /uv /uvx /bin/
RUN apt-get update \
    && apt-get upgrade -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*
RUN useradd --create-home --uid 10001 appuser
COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --locked --group dev --no-install-project
COPY backend/app ./app
COPY backend/migrations ./migrations
COPY backend/tests ./tests
COPY scripts ./scripts
COPY backend/alembic.ini ./
COPY data /srv/data
RUN mkdir -p data/runtime \
    && chown -R appuser:appuser /srv/backend
USER appuser
CMD ["sh", "-lc", "uv run --no-sync pytest && uv run --no-sync ruff check app tests scripts/quality-evaluation"]
